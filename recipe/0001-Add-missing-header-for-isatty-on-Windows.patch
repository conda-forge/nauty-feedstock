From f9048378dfe9b0a55d662863d44eaf85de009501 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Julian=20R=C3=BCth?= <julian.rueth@fsfe.org>
Date: Thu, 7 Dec 2023 08:25:21 +0200
Subject: [PATCH] Add missing headers on Windows

diff --git a/delptg.c b/delptg.c
index 75d2b06..4467b51 100644
--- a/delptg.c
+++ b/delptg.c
@@ -30,6 +30,9 @@
 
 /*************************************************************************/
 
+#ifdef _MSC_VER
+#include <BaseTsd.h>
+#endif
 #include "gtools.h" 
 
 static FILE *outfile;
@@ -37,6 +40,10 @@ static nauty_counter nout;
 static int outcode;
 static boolean digraph,dolabel;
 
+#ifdef _MSC_VER
+typedef SSIZE_T ssize_t;   /* MSVC has no ssize_t */
+#endif
+
 /**************************************************************************/
 
 static void
diff --git a/naututil-h.in b/naututil-h.in
index db9437b..04304a6 100644
--- a/naututil-h.in
+++ b/naututil-h.in
@@ -128,6 +128,9 @@ used, it is necessary to check they are correct.
 #include "nauty.h"              /* which includes stdio.h */
 #include "nausparse.h"
 #include "naurng.h"
+#ifdef _WIN32
+#include <io.h>              /* isatty, fileno */
+#endif
 /* At this point we can assume that <sys/types.h>, <unistd.h>, <stddef.h>,
    <stdlib.h>, <string.h> or <strings.h> and <malloc.h> if necessary have
    been included if they exist. */
diff --git a/showg.c b/showg.c
index 4c11bde..e520c6b 100644
--- a/showg.c
+++ b/showg.c
@@ -52,6 +52,7 @@
 
 #include <stdio.h>
 #include <string.h>
+#include <stdlib.h>
 
 /* gtools.h : General header for gtools programs. */
 
@@ -146,9 +147,6 @@ int errno = 0;
 #include <stdlib.h>
 #else
 #include <sys/types.h>
-char *calloc();
-char *malloc();
-char *realloc();
 #endif
 
 #ifdef __alpha
-- 
2.56.1

