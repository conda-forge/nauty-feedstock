Subject: [PATCH] Only include <unistd.h> if it exists

---
 configure.ac | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/configure.ac b/configure.ac
index be69771..b3aec38 100644
--- a/configure.ac
+++ b/configure.ac
@@ -40,7 +40,9 @@ AC_DEFUN([AC_CHECK_POSIXDECL],
 #endif
 #include <stdio.h>
 #include <stdlib.h>
