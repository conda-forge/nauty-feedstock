From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Julian=20R=C3=BCth?= <julian.rueth@fsfe.org>
Date: Sun, 22 Nov 2026 17:39:47 -0600
Subject: [PATCH] Use $(OBJEXT) for object file names

When compiling with MSVC compilers on Windows (e.g., clang-cl), libtool
names objects .obj and not .o.
---
 configure.ac |   2 +-
 makefile.in  | 273 ++++++++++++++++++++++++++-------------------------
 2 files changed, 138 insertions(+), 137 deletions(-)

diff --git a/configure.ac b/configure.ac
index b3aec38..3747146 100644
--- a/configure.ac
+++ b/configure.ac
@@ -575,7 +575,7 @@ AC_SUBST(have_gunzip)
 LT_INIT
 AC_SUBST([enable_static])
 AS_IF([test "x$enable_static" = "xyes"],
-      [osuffix=".o" ; olist=""],
+      [osuffix=".$OBJEXT" ; olist=""],
       [osuffix=".lo" ; olist="L"])
 AC_SUBST([osuffix])
 AC_SUBST([olist])
diff --git a/makefile.in b/makefile.in
index da077f0..df0c5d5 100644
